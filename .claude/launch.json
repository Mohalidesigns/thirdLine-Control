{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "secondline",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "serve",
                "--port=8090"
            ],
            "port": 8090
        },
        {
            "name": "secondline-alt",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "serve",
                "--port=8091"
            ],
            "port": 8091
        },
        {
            "name": "secondline-e2e",
            "runtimeExecutable": "sh",
            "runtimeArgs": [
                "-c",
                "APP_ENV=e2e php artisan serve --host=127.0.0.1 --port=8123"
            ],
            "port": 8123
        },
        {
            "name": "secondline-vite",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "vite",
                "--host=127.0.0.1",
                "--port=5174",
                "--strictPort"
            ],
            "port": 5174
        }
    ]
}
