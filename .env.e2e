# ── AI layer (Phase 14) ──────────────────────────────────────────────
# The local Ollama server running IBM Granite. Tenant data never leaves
# the machine. Clear OLLAMA_BASE_URL and the AI layer stays dormant:
# every capability reports itself unavailable instead of failing
# mid-request. OLLAMA_API_KEY is only for an Ollama behind an
# authenticating proxy; read only via config/services.php, never from a
# class, seeder, test or prompt (R9).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
# Installation defaults only. The operative model per capability is a row
# in ai_configurations, so a tenant can pin a model without a deploy.
# One Granite serves all three tiers; point the reasoning tier at a
# larger Granite when one is pulled.
OLLAMA_MODEL=granite4:micro
OLLAMA_REASONING_MODEL=granite4:micro
OLLAMA_FAST_MODEL=granite4:micro
OLLAMA_MAX_TOKENS=8192
# Context window per call — Ollama's own default silently truncates a
# large retrieval context.
OLLAMA_NUM_CTX=16384
# Local inference is slow on modest hardware; give generations room.
OLLAMA_TIMEOUT=300
OLLAMA_MAX_RETRIES=3
