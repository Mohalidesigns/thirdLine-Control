APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Continuous controls monitoring (Phase 12) ────────────────────────
# Snapshots of extracted data. Point the disk at in-country storage: the
# path begins with the tenant's data-residency code so residency is
# provable per file.
CCM_SNAPSHOT_DISK=local
CCM_SNAPSHOT_ROOT=ccm/snapshots
CCM_MAX_ROWS=500000
CCM_MAX_BYTES=268435456
CCM_SQL_TIMEOUT=10
CCM_SQL_MAX_ROWS=50000
CCM_MAX_FINDINGS=2000
# HMAC salt for pseudonymising sensitive personal fields at ingestion.
# Leave blank to derive from APP_KEY; set explicitly in production.
CCM_PII_SALT=

# ── Dashboards, reporting & submissions (Phase 13) ───────────────────
# Seconds a resolved dashboard tile is cached. Every key carries the
# tenant and the viewer's permission fingerprint, so a cached tile can
# never be served to someone entitled to less. Zero disables it.
DASHBOARD_CACHE_TTL=60
# Widgets per dashboard. The cap is a performance budget, not taste:
# past this a board stops being useful before it finishes loading.
DASHBOARD_MAX_WIDGETS=24
# Disk generated reports are written to, and how long a download link
# lives. A board-pack link that never expires is a leak waiting for a
# forwarded email.
REPORT_DISK=local
REPORT_LINK_TTL_HOURS=72
# Completeness floor below which a regulatory submission pack refuses to
# be filed. A compliance judgement, so it is a setting, not a constant.
SUBMISSION_COMPLETENESS_THRESHOLD=95

# ── AI layer (Phase 14) ──────────────────────────────────────────────
# The local Ollama server running IBM Granite. Tenant data never leaves
# the machine. Clear OLLAMA_BASE_URL and the AI layer stays dormant:
# every capability reports itself unavailable instead of failing
# mid-request. OLLAMA_API_KEY is only for an Ollama behind an
# authenticating proxy; read only via config/services.php, never from a
# class, seeder, test or prompt (R9).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
# Installation defaults only. The operative model per capability is a row
# in ai_configurations, so a tenant can pin a model without a deploy.
# One Granite serves all three tiers; point the reasoning tier at a
# larger Granite when one is pulled.
OLLAMA_MODEL=granite4:micro
OLLAMA_REASONING_MODEL=granite4:micro
OLLAMA_FAST_MODEL=granite4:micro
OLLAMA_MAX_TOKENS=8192
# Context window per call — Ollama's own default silently truncates a
# large retrieval context.
OLLAMA_NUM_CTX=16384
# Local inference is slow on modest hardware; give generations room.
OLLAMA_TIMEOUT=300
OLLAMA_MAX_RETRIES=3

# Redaction is mandatory and cannot be skipped per request; this switch
# exists for a residency review, not for convenience. Turning it off in
# production is a data-protection decision someone has to sign.
AI_REDACTION_ENABLED=true
# Monetary amounts are usually the point of the analysis, so they are
# kept by default. Turn on where balances are customer-level.
AI_REDACT_AMOUNTS=false

# Retrieval. Permission filtering happens in SQL before the model sees
# anything; these only tune recall and cost.
AI_RETRIEVAL_TOP_K=12
AI_EMBEDDING_DRIVER=hash
AI_EMBEDDING_DIMENSIONS=256

# Cost ceiling per tenant per month. hard_stop refuses the call rather
# than warning — the only honest behaviour for a spend cap.
AI_MONTHLY_TOKEN_BUDGET=5000000
AI_MONTHLY_COST_BUDGET_MINOR=50000
AI_BUDGET_CURRENCY=USD
AI_BUDGET_HARD_STOP=true
AI_RATE_PER_USER=30
AI_RATE_PER_TENANT=120

# ── Mobile, offline & omnichannel (Phase 15) ─────────────────────────
# Every channel below ships DORMANT: with the credentials blank the
# drivers record `skipped` message-log rows instead of calling out, so
# filling these in later is the whole go-live. Messages always carry a
# notification and a link, never personal data or case content — the
# dispatcher and OutboundContentGuard enforce that regardless of what is
# configured here.

# WhatsApp Business Cloud API (Meta). Templates must be approved by Meta
# before out-of-session sends; sync statuses from the admin messaging
# screen. The app secret verifies inbound webhook signatures; the verify
# token answers Meta's one-time subscription handshake.
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SESSION_WINDOW_HOURS=24

# SMS aggregator: log (default, writes to the app log only), termii or
# africastalking. Cost per segment in minor units feeds per-tenant cost
# tracking (kobo by default); delivery receipts refine it.
SMS_DRIVER=log
SMS_SENDER_ID=SecondLine
SMS_COST_PER_SEGMENT_MINOR=400
SMS_COST_CURRENCY=NGN
TERMII_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Shared token the aggregator must present on delivery-receipt callbacks.
SMS_RECEIPT_TOKEN=

# Web Push (VAPID). Generate a P-256 key pair once per installation, e.g.
#   openssl ecparam -genkey -name prime256v1 -noout -out vapid.pem
# VAPID_PRIVATE_KEY accepts the PEM base64-encoded onto one line;
# VAPID_PUBLIC_KEY is the base64url uncompressed public point browsers get.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# USSD attestation flow — optional, also behind the `ussd` feature flag.
USSD_WEBHOOK_TOKEN=

# Phase 16 — data residency (16.2). Which country each storage/broker
# region sits in; the residency guard blocks a write, dispatch, backup or
# outbound call whose target is declared outside the tenant's country.
# There is deliberately no variable that turns the guard off.
RESIDENCY_DEFAULT_COUNTRY=NG
RESIDENCY_DISK_LOCAL=NG
RESIDENCY_DISK_PUBLIC=NG
RESIDENCY_DISK_S3=NG
RESIDENCY_QUEUE_DATABASE=*
RESIDENCY_QUEUE_REDIS=NG
RESIDENCY_BACKUP_DISK=local

# Phase 16 — observability (16.3). Set LOG_CHANNEL=structured (or add
# 'structured' to LOG_STACK) for JSON logs with request correlation ids.
LOG_DAILY_DAYS=30
