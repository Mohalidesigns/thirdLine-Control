APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Continuous controls monitoring (Phase 12) ────────────────────────
# Snapshots of extracted data. Point the disk at in-country storage: the
# path begins with the tenant's data-residency code so residency is
# provable per file.
CCM_SNAPSHOT_DISK=local
CCM_SNAPSHOT_ROOT=ccm/snapshots
CCM_MAX_ROWS=500000
CCM_MAX_BYTES=268435456
CCM_SQL_TIMEOUT=10
CCM_SQL_MAX_ROWS=50000
CCM_MAX_FINDINGS=2000
# HMAC salt for pseudonymising sensitive personal fields at ingestion.
# Leave blank to derive from APP_KEY; set explicitly in production.
CCM_PII_SALT=

# ── Dashboards, reporting & submissions (Phase 13) ───────────────────
# Seconds a resolved dashboard tile is cached. Every key carries the
# tenant and the viewer's permission fingerprint, so a cached tile can
# never be served to someone entitled to less. Zero disables it.
DASHBOARD_CACHE_TTL=60
# Widgets per dashboard. The cap is a performance budget, not taste:
# past this a board stops being useful before it finishes loading.
DASHBOARD_MAX_WIDGETS=24
# Disk generated reports are written to, and how long a download link
# lives. A board-pack link that never expires is a leak waiting for a
# forwarded email.
REPORT_DISK=local
REPORT_LINK_TTL_HOURS=72
# Completeness floor below which a regulatory submission pack refuses to
# be filed. A compliance judgement, so it is a setting, not a constant.
SUBMISSION_COMPLETENESS_THRESHOLD=95

# ── AI layer (Phase 14) ──────────────────────────────────────────────
# The Anthropic key. Read only via config/services.php, never from a
# class, seeder, test or prompt (R9). Leave blank and the AI layer stays
# dormant: every capability reports itself unavailable instead of failing
# mid-request.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Installation defaults only. The operative model per capability is a row
# in ai_configurations, so a tenant can pin a model without a deploy.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_REASONING_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=3

# Redaction is mandatory and cannot be skipped per request; this switch
# exists for a residency review, not for convenience. Turning it off in
# production is a data-protection decision someone has to sign.
AI_REDACTION_ENABLED=true
# Monetary amounts are usually the point of the analysis, so they are
# kept by default. Turn on where balances are customer-level.
AI_REDACT_AMOUNTS=false

# Retrieval. Permission filtering happens in SQL before the model sees
# anything; these only tune recall and cost.
AI_RETRIEVAL_TOP_K=12
AI_EMBEDDING_DRIVER=hash
AI_EMBEDDING_DIMENSIONS=256

# Cost ceiling per tenant per month. hard_stop refuses the call rather
# than warning — the only honest behaviour for a spend cap.
AI_MONTHLY_TOKEN_BUDGET=5000000
AI_MONTHLY_COST_BUDGET_MINOR=50000
AI_BUDGET_CURRENCY=USD
AI_BUDGET_HARD_STOP=true
AI_RATE_PER_USER=30
AI_RATE_PER_TENANT=120
