            "sort_order": 4,
            "requirement_type": "section",
            "is_testable": true,
            "suggested_frequency": "Monthly",
            "verification_status": "unverified",
            "guidance": "PAYE monthly by the 10th with annual returns by 31 January; NSITF 1% of monthly payroll; pension 8% employee plus 10% employer, remitted within 7 days of salary payment."
        },
