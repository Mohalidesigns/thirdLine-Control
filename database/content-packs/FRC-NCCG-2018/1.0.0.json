    "obligations": [
        {
            "obligation_ref": "FRC-CG-001-RETURN",
            "title": "Corporate governance return FRC/CG/001",
            "obligation_type": "filing",
            "trigger_type": "calendar",
            "frequency": "annual",
            "grace_period_days": 0,
            "verification_status": "unverified",
            "is_active": true,
            "description": "The annual corporate governance return, sections A to E: introduction; general information (incorporation date, RC number, auditors, registrars, contacts); board composition, appointment dates and meeting attendance per director and per committee; senior management positions, names and gender; and the application narrative for each of the 28 principles. \"N/A\" responses are prohibited. Certified by four signatories: the Chairman, the MD/CEO, the Governance Committee Chair and the Company Secretary.",
            "due_rule": {
                "type": "relative",
                "anchor": "fiscal_year_end",
                "offset_days": 180
            },
            "applies_to": {
                "entity_types": [
                    "listed_company",
                    "commercial_bank",
                    "merchant_bank",
                    "non_interest_bank",
                    "insurer",
                    "pension_operator",
                    "public_limited_company",
                    "government_licensee",
                    "concessioned_company"
                ],
                "jurisdictions": [
                    "NG"
                ]
            },
            "legal_reference": "FRC Nigerian Code of Corporate Governance 2018; return FRC/CG/001",
            "effective_from": "2019-01-01"
        },
