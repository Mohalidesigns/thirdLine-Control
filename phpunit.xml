<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Rendering a full board pack through dompdf is genuinely memory
             hungry, and the report suite renders every shipped report in
             every format it publishes in one process. Production runs these
             on a worker sized the same way; size any matching prod worker
             accordingly.

             History, because this ceiling has now moved twice for the same
             reason and the next person deserves numbers rather than
             folklore:

               · 512M → 1024M with CR3. The Activity Log doubled the audit
                 write volume per test and the 868-test suite crossed the
                 old ceiling near the end of the alphabet.
               · 1024M → 2048M with CR-04, which added INV-REPORT to the
                 shipped catalogue — so ReportDesignerTest, which renders
                 EVERY system report in EVERY format it declares, gained two
                 more documents — plus a suite of its own that renders an
                 investigation report as both PDF and DOCX.

             Measured peak on a macOS/Herd PHP 8.4 build at the 1,001-test
             mark: 551 MB. The GitHub runner's build used enough more than
             that to die at 1024M — deterministically, twice, on the first
             test alphabetically after ReportDesignerTest — which is why the
             headroom is now roughly 4× the measured local peak rather than
             2×. If it moves again, measure first:
             `php -d auto_prepend_file=<script printing memory_get_peak_usage(true)> vendor/bin/phpunit`. -->
        <ini name="memory_limit" value="2048M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
